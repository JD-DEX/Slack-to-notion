# Copy this file to .env for local runs. Never commit .env.
# On Railway, set these as service variables instead.

# Slack bot token (Settings > Install App > Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-replace-me
# Slack app-level token with the connections:write scope (Socket Mode)
SLACK_APP_TOKEN=xapp-replace-me
# Notion internal integration token
NOTION_API_TOKEN=replace-me

# Required. Comma-separated Slack user IDs that can use the app.
# The app does not start if this is empty.
ALLOWED_SLACK_USER_IDS=U00000000,U11111111

# Optional. DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: INFO.
LOG_LEVEL=INFO
